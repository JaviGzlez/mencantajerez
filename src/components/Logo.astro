---
// Logotipo oficial (blanco, para fondos oscuros)
interface Props { class?: string; eager?: boolean }
const { class: cls, eager = true } = Astro.props;
---
<picture class:list={['logo', cls]}>
  <source srcset="/img/logo-blanco.webp" type="image/webp" />
  <img
    src="/img/logo-blanco-480.png"
    alt="Mencanta Jerez · Vive la Zambomba Jerezana"
    width="480"
    height="250"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</picture>

<style>
  .logo { display: block; height: 100%; }
  .logo img { display: block; height: 100%; width: auto; }
</style>

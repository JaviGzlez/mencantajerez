---
/**
 * Foto con respaldo.
 * - Si existe public{src} se muestra. Si además existe la versión .webp
 *   (y opcionalmente -1200.webp para móvil) se sirven automáticamente.
 * - Si no existe, usa `fallback` (si se indica) o un fondo degradado.
 * Así basta con copiar las fotos reales en public/img con ese nombre.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  src: string;
  alt: string;
  class?: string;
  eager?: boolean;
  width?: number;
  height?: number;
  fallback?: string;
  position?: string; // object-position, ej. "75% center"
}
const { src, alt, class: cls, eager = false, width = 1600, height = 1067, fallback, position } = Astro.props;
const pub = (p: string) => path.join(process.cwd(), 'public', p);
const exists = (p: string) => fs.existsSync(pub(p));

const real = exists(src) ? src : fallback && exists(fallback) ? fallback : null;
let webp: string | null = null;
let webpSmall: string | null = null;
if (real) {
  const base = real.replace(/\.(jpe?g|png)$/i, '');
  if (exists(`${base}.webp`)) webp = `${base}.webp`;
  if (exists(`${base}-1200.webp`)) webpSmall = `${base}-1200.webp`;
}
const srcset = webp ? (webpSmall ? `${webpSmall} 1200w, ${webp} 2000w` : webp) : null;
const style = position ? `object-position:${position}` : undefined;
---
{real ? (
  <picture class:list={['photo-wrap', cls]}>
    {srcset && <source srcset={srcset} sizes="100vw" type="image/webp" />}
    <img
      src={real}
      alt={alt}
      class="photo"
      style={style}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </picture>
) : (
  <div class:list={['photo', 'photo-ph', cls]} role="img" aria-label={alt}>
    {import.meta.env.DEV && <span>Foto pendiente<br /><code>public{src}</code></span>}
  </div>
)}

<style>
  .photo-wrap { display: block; width: 100%; height: 100%; }
  .photo { display: block; width: 100%; height: 100%; object-fit: cover; }
  .photo-ph {
    display: grid; place-items: center; text-align: center;
    background:
      radial-gradient(ellipse at 50% 110%, rgba(233, 138, 60, 0.55), transparent 55%),
      radial-gradient(ellipse at 20% 0%, rgba(134, 25, 46, 0.7), transparent 60%),
      linear-gradient(160deg, #3b0a14, #1f0509);
    color: rgba(246, 238, 225, 0.6);
    font-size: 0.8rem; line-height: 1.5; min-height: 100%;
  }
  .photo-ph code { font-size: 0.72rem; color: rgba(233, 192, 122, 0.8); }
</style>

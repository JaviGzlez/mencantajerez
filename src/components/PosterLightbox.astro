---
// Visor de carteles: cualquier elemento con data-poster="/img/..jpg" lo abre.
---
<dialog class="poster-lb" data-poster-lb aria-label="Cartel del menú">
  <button class="lb-close" data-close aria-label="Cerrar">×</button>
  <picture>
    <source data-lb-webp type="image/webp" />
    <img data-lb-img alt="" width="1024" height="1280" />
  </picture>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-poster-lb]')!;
  const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const webp = dlg.querySelector<HTMLSourceElement>('[data-lb-webp]')!;
  document.querySelectorAll<HTMLElement>('[data-poster]').forEach((el) =>
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const src = el.dataset.poster!;
      webp.srcset = src.replace(/\.(jpe?g|png)$/, '.webp');
      img.src = src;
      img.alt = el.dataset.title ?? 'Cartel del menú';
      dlg.showModal();
    }),
  );
  dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  .poster-lb { padding: 0; border: 0; background: transparent; width: 100vw; height: 100dvh; max-width: 100vw; max-height: 100dvh; }
  .poster-lb::backdrop { background: rgba(15, 2, 4, 0.92); }
  .poster-lb[open] { display: grid; place-items: center; }
  .poster-lb img { max-width: min(92vw, 640px); max-height: 88dvh; width: auto; height: auto; border-radius: 8px; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5); }
  .lb-close { position: fixed; top: 16px; right: 16px; width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.3); background: rgba(255, 255, 255, 0.1); color: #fff; font-size: 1.8rem; line-height: 1; cursor: pointer; }
</style>

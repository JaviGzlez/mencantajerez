---
import { site, waLink, telLink } from '../data/site';
import Icon from './Icon.astro';
---
<!-- Botón flotante de WhatsApp (escritorio y tablet) -->
<a class="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <Icon name="whatsapp" />
  <span class="wa-label">¿Hablamos?</span>
</a>

<!-- Barra fija en móvil -->
<div class="mobile-bar" aria-label="Contacto rápido">
  <a href={telLink(site.phones[0])} class="mb-call"><Icon name="phone" /> Llamar</a>
  <a href={waLink()} target="_blank" rel="noopener" class="mb-wa"><Icon name="whatsapp" /> WhatsApp</a>
</div>

<style>
  .wa-float {
    position: fixed; right: 24px; bottom: 24px; z-index: 60;
    display: flex; align-items: center; gap: 0;
    height: 60px; padding: 0 18px; border-radius: 999px;
    background: var(--wa); color: #fff; text-decoration: none; font-weight: 600;
    box-shadow: 0 10px 30px rgba(37, 211, 102, 0.35), 0 4px 10px rgba(0, 0, 0, 0.15);
    transition: gap 0.3s ease, transform 0.2s ease;
  }
  .wa-float::before {
    content: ''; position: absolute; inset: 0; border-radius: inherit;
    border: 2px solid var(--wa); animation: wa-pulse 2.6s ease-out infinite;
  }
  .wa-float :global(svg) { width: 26px; height: 26px; flex: none; }
  .wa-label { max-width: 0; overflow: hidden; white-space: nowrap; transition: max-width 0.35s ease; }
  .wa-float:hover { gap: 10px; transform: translateY(-2px); }
  .wa-float:hover .wa-label { max-width: 120px; }

  @keyframes wa-pulse {
    0% { transform: scale(1); opacity: 0.7; }
    80%, 100% { transform: scale(1.35); opacity: 0; }
  }

  .mobile-bar { display: none; }

  @media (max-width: 560px) {
    .wa-float { display: none; }
    .mobile-bar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      display: grid; grid-template-columns: 1fr 1.4fr; gap: 10px;
      padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
      background: rgba(31, 5, 9, 0.96); backdrop-filter: blur(10px);
      border-top: 1px solid var(--line-light);
    }
    .mobile-bar a {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      min-height: 50px; border-radius: 999px; text-decoration: none; font-weight: 600;
    }
    .mobile-bar :global(svg) { width: 20px; height: 20px; }
    .mb-call { color: #fff; border: 1px solid rgba(255, 255, 255, 0.35); }
    .mb-wa { background: var(--wa); color: #fff; }
  }
</style>

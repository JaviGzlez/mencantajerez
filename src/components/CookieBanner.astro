---
/**
 * Aviso de cookies + carga del Píxel de Meta.
 * - "Aceptar": guarda 'all' y carga el píxel.
 * - "Rechazar": guarda 'necessary' y no se carga nada de terceros.
 * La elección se guarda en localStorage ('mj-consent').
 * Cualquier elemento con data-cookie-settings vuelve a abrir el aviso.
 * Para enviar eventos desde otras partes de la web: window.mjTrack('Lead', {...})
 */
import { site } from '../data/site';
---
<div class="cookie" data-cookie role="dialog" aria-live="polite" aria-label="Aviso de cookies" hidden>
  <p>Usamos cookies propias y de Meta para medir y mejorar nuestros anuncios. <a href="/cookies">Más info</a></p>
  <div class="cookie-actions">
    <button type="button" class="c-btn ghost" data-cookie-reject>Rechazar</button>
    <button type="button" class="c-btn" data-cookie-accept>Aceptar</button>
  </div>
</div>

<script is:inline define:vars={{ pixelId: site.metaPixelId }}>
  (function () {
    var KEY = 'mj-consent';
    var loaded = false;
    var queue = [];
    function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }

    function loadPixel() {
      if (loaded || !pixelId) return;
      loaded = true;
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
      document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', pixelId);
      fbq('track', 'PageView');
      if (/^\/menus\/?$/.test(location.pathname)) fbq('track', 'ViewContent', { content_name: 'Menús de Navidad' });
      queue.forEach(function (a) { fbq('track', a[0], a[1]); });
      queue = [];
    }

    // Disponible para el resto de la web (p. ej. el formulario de reserva)
    window.mjTrack = function (event, params) {
      if (loaded && window.fbq) fbq('track', event, params || {});
      else if (read() === 'all') queue.push([event, params || {}]);
    };

    if (read() === 'all') loadPixel();

    document.addEventListener('DOMContentLoaded', function () {
      var box = document.querySelector('[data-cookie]');
      if (!box) return;
      var current = read();
      if (current) document.documentElement.dataset.consent = current; else box.hidden = false;
      function save(v) {
        try { localStorage.setItem(KEY, v); } catch (e) {}
        box.hidden = true;
        document.documentElement.dataset.consent = v;
        if (v === 'all') loadPixel();
      }
      box.querySelector('[data-cookie-accept]').addEventListener('click', function () { save('all'); });
      box.querySelector('[data-cookie-reject]').addEventListener('click', function () { save('necessary'); });
      document.querySelectorAll('[data-cookie-settings]').forEach(function (el) {
        el.addEventListener('click', function (e) { e.preventDefault(); box.hidden = false; });
      });
    });
  })();
</script>

<style>
  .cookie {
    position: fixed; z-index: 80; left: 16px; bottom: 16px; max-width: 460px;
    display: flex; align-items: center; gap: 14px;
    padding: 10px 12px 10px 16px;
    background: rgba(31, 5, 9, 0.95); color: rgba(246, 238, 225, 0.88);
    border: 1px solid rgba(233, 192, 122, 0.25); border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); backdrop-filter: blur(8px);
    font-size: 0.84rem; line-height: 1.4;
  }
  .cookie[hidden] { display: none; }
  .cookie p { margin: 0; }
  .cookie a { color: var(--gold-400); }
  .cookie-actions { display: flex; gap: 6px; flex: none; }
  .c-btn {
    font: 600 0.8rem/1 var(--font-body); padding: 8px 12px; min-height: 34px; border-radius: 999px; cursor: pointer;
    background: var(--gold-400); color: var(--wine-950); border: 1px solid var(--gold-400);
  }
  .c-btn.ghost { background: transparent; color: rgba(246, 238, 225, 0.85); border-color: rgba(246, 238, 225, 0.3); }
  .c-btn:hover { filter: brightness(1.08); }
  @media (max-width: 560px) {
    .cookie { left: 8px; right: 8px; max-width: none; bottom: calc(76px + env(safe-area-inset-bottom)); padding: 8px 8px 8px 12px; font-size: 0.8rem; gap: 10px; }
  }
</style>

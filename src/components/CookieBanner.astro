---
/**
 * Aviso de cookies.
 * La web no usa cookies propias de seguimiento. Lo único de terceros es
 * el mapa de Google Maps, que solo se carga si el visitante acepta.
 * Guarda la elección en localStorage ('mj-consent': 'all' | 'necessary')
 * y avisa al resto de la página con el evento 'mj-consent'.
 * Cualquier enlace con data-cookie-settings vuelve a abrir el aviso.
 */
---
<div class="cookie" data-cookie role="dialog" aria-live="polite" aria-label="Aviso de cookies" hidden>
  <p>Esta web solo usa cookies técnicas necesarias para funcionar. <a href="/cookies">Más info</a></p>
  <div class="cookie-actions">
    <button type="button" class="c-btn" data-cookie-accept>Entendido</button>
  </div>
</div>

<script>
  const KEY = 'mj-consent';
  const box = document.querySelector<HTMLElement>('[data-cookie]')!;
  const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
  const save = (v: string) => {
    try { localStorage.setItem(KEY, v); } catch {}
    box.hidden = true;
    document.documentElement.dataset.consent = v;
    window.dispatchEvent(new CustomEvent('mj-consent', { detail: v }));
  };
  const current = read();
  if (current) document.documentElement.dataset.consent = current;
  else box.hidden = false;

  box.querySelector('[data-cookie-accept]')!.addEventListener('click', () => save('all'));
  document.querySelectorAll('[data-cookie-settings]').forEach((el) =>
    el.addEventListener('click', (e) => { e.preventDefault(); box.hidden = false; }),
  );
</script>

<style>
  .cookie {
    position: fixed; z-index: 80; left: 16px; bottom: 16px; max-width: 460px;
    display: flex; align-items: center; gap: 14px;
    padding: 10px 12px 10px 16px;
    background: rgba(31, 5, 9, 0.95); color: rgba(246, 238, 225, 0.88);
    border: 1px solid rgba(233, 192, 122, 0.25); border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); backdrop-filter: blur(8px);
    font-size: 0.84rem; line-height: 1.4;
  }
  .cookie[hidden] { display: none; }
  .cookie p { margin: 0; }
  .cookie a { color: var(--gold-400); }
  .cookie-actions { display: flex; gap: 6px; flex: none; }
  .c-btn {
    font: 600 0.8rem/1 var(--font-body); padding: 8px 12px; min-height: 34px; border-radius: 999px; cursor: pointer;
    background: var(--gold-400); color: var(--wine-950); border: 1px solid var(--gold-400);
  }
  .c-btn.ghost { background: transparent; color: rgba(246, 238, 225, 0.85); border-color: rgba(246, 238, 225, 0.3); }
  .c-btn:hover { filter: brightness(1.08); }
  @media (max-width: 560px) {
    .cookie { left: 8px; right: 8px; max-width: none; bottom: calc(76px + env(safe-area-inset-bottom)); padding: 8px 8px 8px 12px; font-size: 0.8rem; gap: 10px; }
  }
</style>

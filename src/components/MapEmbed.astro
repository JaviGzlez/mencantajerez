---
// Tarjeta de ubicación: foto del local + dirección + botón a Google Maps.
// No carga ningún mapa de terceros, así que no instala cookies.
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { fotos } from '../data/fotos';
---
<a class="loc" href={site.mapLink} target="_blank" rel="noopener" aria-label={`Cómo llegar a ${site.name}, ${site.address.street}, ${site.address.city}`}>
  <div class="bg"><Photo src={fotos.grupoPatio.src} alt="" /></div>
  <div class="body">
    <span class="pin"><Icon name="pin" /></span>
    <p class="kicker">Te esperamos en</p>
    <p class="addr">{site.address.street}</p>
    <p class="city">Centro de {site.address.city.replace(' de la Frontera', '')}</p>
    <span class="btn btn-gold go">Cómo llegar <Icon name="arrow" /></span>
  </div>
</a>

<style>
  .loc {
    position: relative; isolation: isolate; display: flex; align-items: flex-end;
    aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden;
    text-decoration: none; color: #fff; box-shadow: var(--shadow-lg);
  }
  .bg { position: absolute; inset: 0; z-index: -1; }
  .bg :global(.photo) { transition: transform 0.6s ease; }
  .loc:hover .bg :global(.photo) { transform: scale(1.04); }
  .bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20, 3, 6, 0.92) 0%, rgba(20, 3, 6, 0.55) 45%, rgba(20, 3, 6, 0.15) 100%); }
  .body { padding: clamp(20px, 3vw, 30px); width: 100%; }
  .pin { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--gold-400); color: var(--wine-950); margin-bottom: 14px; }
  .pin :global(svg) { width: 22px; height: 22px; }
  .kicker { margin: 0 0 2px; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-400); }
  .addr { margin: 0; font-family: var(--font-display); font-size: clamp(1.5rem, 2.4vw, 1.9rem); line-height: 1.15; }
  .city { margin: 2px 0 16px; color: rgba(246, 238, 225, 0.8); }
  .go { min-height: 44px; padding: 10px 22px; }
</style>

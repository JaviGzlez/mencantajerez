---
/**
 * Formulario de reserva (almuerzos). Al enviar abre WhatsApp con el mensaje relleno.
 * Se usa en la ventana emergente (ReservaModal) y en /contacto.
 * Las fechas disponibles salen de site.openDays (src/data/site.ts).
 */
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props { variant?: 'modal' | 'page' }
const { variant = 'page' } = Astro.props;

// Solo los menús con cartel (los reales). Un .md sin cartel no aparece en el formulario.
const menus = (await getCollection('menus', ({ data }) => data.active && !!data.poster)).sort((a, b) => a.data.order - b.data.order);
const days = site.openDays.map((iso) => {
  const label = new Date(`${iso}T12:00:00`).toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Madrid' });
  return { iso, label: label.charAt(0).toUpperCase() + label.slice(1) };
});
---
<form class:list={['res-form', variant]} data-res-form novalidate>
  <p class="kicker">Reserva tu mesa</p>
  <h2 class="title">Almuerzo de Navidad</h2>

  <div class="row">
    <label>Nombre<input name="nombre" required autocomplete="name" placeholder="Tu nombre" /></label>
    <label>Teléfono<input name="telefono" type="tel" required autocomplete="tel" inputmode="tel" placeholder="600 000 000" /></label>
  </div>

  <label>Día
    <select name="fecha" required data-days>
      <option value="">Elige un día</option>
      {days.map((d) => <option value={d.iso} data-label={d.label}>{d.label}</option>)}
    </select>
  </label>

  <div class="row">
    <label>Menú
      <select name="menu" required data-menu-select>
        <option value="">Elige menú</option>
        {menus.map((m) => <option value={m.data.name}>{m.data.name} · {m.data.price} €</option>)}
      </select>
    </label>
    <label>Personas<input name="personas" type="number" min="1" max="500" inputmode="numeric" required placeholder="Ej: 8" /></label>
  </div>

  <label><span>Comentarios <span class="opt">(opcional)</span></span>
    <textarea name="mensaje" rows="2" placeholder="Alergias, niños, varios menús…"></textarea>
  </label>

  <label class="check">
    <input type="checkbox" name="privacidad" required />
    <span>Acepto la <a href="/privacidad" target="_blank">política de privacidad</a>.</span>
  </label>

  <p class="error" data-error role="alert" hidden></p>
  <p class="ok" data-ok role="status" hidden>Abriendo WhatsApp… Si no se abre, <a data-ok-link href="#" target="_blank" rel="noopener">pulsa aquí</a>.</p>

  <button class="btn submit" type="submit">Continuar por WhatsApp <Icon name="whatsapp" /></button>
</form>

<script define:vars={{ phone: site.whatsapp }}>
  document.querySelectorAll('[data-res-form]').forEach((form) => {
    if (form.dataset.ready) return;
    form.dataset.ready = '1';
    const $ = (s) => form.querySelector(s);
    const errEl = $('[data-error]');
    const okEl = $('[data-ok]');
    const okLink = $('[data-ok-link]');

    // Oculta los días que ya han pasado
    const today = new Date();
    const todayIso = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    form.querySelectorAll('[data-days] option[value]').forEach((o) => { if (o.value && o.value < todayIso) o.remove(); });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      errEl.hidden = true;
      const bad = [...form.querySelectorAll('[required]')].find((el) => (el.type === 'checkbox' ? !el.checked : !el.value.trim()));
      if (bad) {
        errEl.textContent = bad.type === 'checkbox' ? 'Acepta la política de privacidad para continuar.' : 'Rellena todos los campos, por favor.';
        errEl.hidden = false;
        bad.focus();
        return;
      }
      const f = Object.fromEntries(new FormData(form));
      const dayLabel = $('[data-days]').selectedOptions[0].dataset.label;
      const L = [
        '*RESERVA ALMUERZO · MENCANTA JEREZ*',
        '',
        `*Nombre:* ${f.nombre.trim()}`,
        `*Teléfono:* ${f.telefono.trim()}`,
        `*Día:* ${dayLabel}`,
        `*Menú:* ${f.menu}`,
        `*Personas:* ${f.personas}`,
      ];
      if (f.mensaje && f.mensaje.trim()) L.push(`*Comentarios:* ${f.mensaje.trim()}`);

      const url = `https://wa.me/${phone}?text=${encodeURIComponent(L.join('\n'))}`;
      okLink.href = url;
      okEl.hidden = false;
      // Conversión para Meta (solo se envía si el usuario ha aceptado cookies)
      if (window.mjTrack) window.mjTrack('Lead', { content_name: f.menu, num_items: Number(f.personas) || 1 });
      const mobile = matchMedia('(pointer: coarse)').matches || /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
      if (mobile) { location.href = url; return; }
      const w = window.open(url, '_blank');
      if (w) w.opener = null; else location.href = url;
    });
  });
</script>

<style>
  .res-form { font-size: 0.95rem; color: var(--ink-900); }
  .res-form.page { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: clamp(22px, 4vw, 36px); }
  .kicker { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--wine-700); margin: 0 0 6px; }
  .title { font-size: clamp(1.35rem, 2.4vw, 1.6rem); margin: 0 0 18px; }
  label { display: flex; flex-direction: column; gap: 5px; margin-bottom: 12px; font-size: 0.82rem; font-weight: 500; color: var(--ink-700); min-width: 0; }
  .opt { color: var(--ink-500); font-weight: 400; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  input, select, textarea {
    font: inherit; font-size: 0.97rem; color: var(--ink-900); width: 100%;
    padding: 10px 12px; min-height: 44px; border: 1px solid rgba(74, 13, 24, 0.2); border-radius: 10px;
    background: #fff; transition: border-color 0.2s, box-shadow 0.2s;
  }
  input::placeholder, textarea::placeholder { color: #a8998f; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--wine-700); box-shadow: 0 0 0 3px rgba(107, 20, 36, 0.12); }
  textarea { resize: vertical; min-height: 60px; }

  .check { flex-direction: row; align-items: center; gap: 10px; font-size: 0.84rem; font-weight: 400; margin: 4px 0 14px; }
  .check input { width: 18px; height: 18px; min-height: 0; padding: 0; accent-color: var(--wine-700); flex: none; }
  .check a { color: var(--wine-700); }

  .error { background: #fdecec; color: #8a1c1c; border-radius: 8px; padding: 9px 12px; font-size: 0.86rem; margin: 0 0 12px; }
  .ok { background: #e8f8ee; color: #14622f; border-radius: 8px; padding: 9px 12px; font-size: 0.86rem; margin: 0 0 12px; }
  .ok a { color: inherit; font-weight: 600; }
  .submit { width: 100%; }

  @media (max-width: 360px) { .row { grid-template-columns: 1fr; gap: 0; } }
</style>

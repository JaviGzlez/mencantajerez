---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ReservaForm from '../components/ReservaForm.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { site, waLink, telLink } from '../data/site';
---
<Base title="Contacto y reservas" description={`Reserva tu almuerzo de Navidad con zambomba en Mencanta Jerez, ${site.address.street}, centro de Jerez. Llámanos al ${site.phones.join(' o ')} o escríbenos por WhatsApp.`}>
  <PageHero
    eyebrow="Contacto"
    title="Hablemos de"
    accent="tu reserva"
    lead="Rellena el formulario y te abrimos WhatsApp con tu reserva ya escrita. También puedes llamarnos."
    image="/img/contacto-hero.jpg"
    alt="Mencanta Jerez en la Plaza Silos"
  />

  <section class="section">
    <div class="container grid-contact">
      <div id="reservar"><ReservaForm /></div>

      <aside class="info">
        <ul>
          <li><span class="ic"><Icon name="whatsapp" /></span><div><strong>WhatsApp</strong><a href="/contacto#reservar" data-reserva>Reservar por WhatsApp</a></div></li>
          <li><span class="ic"><Icon name="phone" /></span><div><strong>Teléfonos</strong>{site.phones.map((p) => <a href={telLink(p)}>{p}</a>)}</div></li>
          {site.email && <li><span class="ic"><Icon name="mail" /></span><div><strong>Email</strong><a href={`mailto:${site.email}`}>{site.email}</a></div></li>}
          <li><span class="ic"><Icon name="pin" /></span><div><strong>Dirección</strong><span>{site.address.street}, {site.address.city}</span><a href={site.mapLink} target="_blank" rel="noopener">Cómo llegar →</a></div></li>
          <li><span class="ic"><Icon name="music" /></span><div><strong>Zambombas</strong><span>Actuación en directo todos los días de {site.band}</span><span class="muted">Entrada gratuita a las actuaciones de nuestra programación</span>{site.hours.map((h) => <span>{h.days}: {h.time}</span>)}</div></li>
          <li><span class="ic"><Icon name="instagram" /></span><div><strong>Síguenos</strong><a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a><a href={site.social.facebook} target="_blank" rel="noopener">Facebook</a></div></li>
        </ul>
        <MapEmbed />
      </aside>
    </div>
  </section>
</Base>

<style>
  #reservar { scroll-margin-top: 100px; }
  .grid-contact { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .info ul { list-style: none; margin: 0 0 28px; padding: 0; }
  .info li { display: flex; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .info li div { display: flex; flex-direction: column; gap: 2px; color: var(--ink-700); min-width: 0; }
  .info strong { color: var(--ink-900); font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .info a { color: var(--wine-700); text-decoration: none; font-weight: 500; }
  .ic { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 12px; background: var(--cream-100); color: var(--wine-700); }
  .ic :global(svg) { width: 21px; height: 21px; }
  @media (max-width: 960px) { .grid-contact { grid-template-columns: 1fr; } }
</style>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { waLink } from '../data/site';

const benefits = [
  { icon: 'plate', title: 'Precio cerrado por persona', text: 'Menús de 40 a 50 € con entrantes, principal, postre y bodega incluida. Sin sorpresas al final.' },
  { icon: 'users', title: 'Para todo el equipo', text: 'Menú sin gluten, vegano e infantil, para que nadie se quede fuera.' },
  { icon: 'glass', title: 'Promociones en copas', text: 'Condiciones especiales en copas para grupos, con música y DJ para alargar la sobremesa.' },
  { icon: 'music', title: 'Zambomba en directo', text: 'Todos los días actúa Los Quintos Mare. Se canta, se ríe y el equipo vuelve a la oficina más unido.' },
] as const;

const faqs = [
  { q: '¿Qué incluye el precio del menú?', a: 'Entrantes para compartir, plato principal, postre y bodega: refrescos, cerveza, vinos generosos de González Byass, tinto y Croft Twist. Además, la actuación en directo de Los Quintos Mare.' },
  { q: '¿Tenéis opciones para personas con alergias o dietas especiales?', a: 'Sí. Tenemos Menú Celíaco, Menú Vegano y Menú Infantil. Si hay alguna otra alergia en el grupo, avísanos al reservar.' },
  { q: '¿Se puede alargar la sobremesa?', a: 'Claro, es lo más típico de una zambomba. Hay música y DJ, y promociones en copas para grupos.' },
  { q: '¿Cómo reservamos?', a: 'Escríbenos por WhatsApp o llámanos al 686 963 422 o al 663 598 345 con la fecha y el número de personas.' },
];
---
<Base
  title="Comidas de empresa de Navidad en Jerez con zambomba"
  description="Comida de empresa de Navidad en el centro de Jerez con zambomba en directo. Menús cerrados por persona con bodega, opciones sin gluten y veganas y copas para grupos."
>
  <PageHero
    eyebrow="Empresas y grupos"
    title="La comida de empresa"
    accent="que todos recuerdan"
    lead="Almuerzos de Navidad para empresas y grupos en pleno centro de Jerez, con zambomba en directo, bodega incluida y promociones en copas."
    image="/img/empresas-hero.jpg"
    alt="Grupo de empresa celebrando la Navidad con zambomba"
  >
    <div class="btn-row">
      <a class="btn btn-gold" href="/contacto#reservar" data-reserva>Reservar para empresa</a>
      <a class="btn btn-ghost" href="/menus">Ver menús <Icon name="arrow" /></a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Por qué con nosotros</span>
        <h2>Todo pensado <em class="accent">para tu equipo</em></h2>
      </div>
      <div class="grid grid-4">
        {benefits.map((b) => (
          <article class="benefit reveal">
            <span class="ic"><Icon name={b.icon} /></span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight bg-cream">
    <div class="container two">
      <div class="img"><Photo src="/img/empresas-mesa.jpg" alt="Mesa larga preparada para una comida de empresa" /></div>
      <div>
        <span class="eyebrow">Cómo lo organizamos</span>
        <h2>Tú nos cuentas, <em class="accent">nosotros lo montamos</em></h2>
        <ol class="flow">
          <li><strong>Nos escribes</strong> con la fecha aproximada y el número de personas.</li>
          <li><strong>Elegís menú</strong>: Menú 1, Menú 2 y, si hace falta, celíaco, vegano o infantil.</li>
          <li><strong>Te confirmamos</strong> disponibilidad para ese día y la reserva queda hecha.</li>
          <li><strong>El día de la comida</strong> solo tenéis que venir a la Plaza Silos. Del resto nos encargamos.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-head center">
        <span class="eyebrow">Dudas de empresas</span>
        <h2>Preguntas <em class="accent">frecuentes</em></h2>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand title="Reserva la fecha" accent="de tu equipo" text="Diciembre se llena rápido. Escríbenos hoy y te confirmamos disponibilidad." />
</Base>

<style>
  .benefit { padding: 30px 26px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .ic { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 14px; background: var(--cream-100); color: var(--wine-700); margin-bottom: 20px; }
  .ic :global(svg) { width: 26px; height: 26px; }
  .benefit h3 { font-size: 1.25rem; color: var(--wine-800); }
  .benefit p { margin: 0; color: var(--ink-700); font-size: 0.98rem; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .img { aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-lg); }
  .flow { counter-reset: f; list-style: none; margin: 8px 0 0; padding: 0; }
  .flow li { counter-increment: f; position: relative; padding: 14px 0 14px 56px; border-bottom: 1px solid var(--line); color: var(--ink-700); }
  .flow li::before {
    content: counter(f); position: absolute; left: 0; top: 12px; display: grid; place-items: center;
    width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--wine-700);
    font-family: var(--font-display); font-style: italic; color: var(--wine-700);
  }
  .flow strong { color: var(--ink-900); }
  @media (max-width: 900px) { .two { grid-template-columns: 1fr; } }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MenuCard from '../components/MenuCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site, waLink } from '../data/site';
import ReservaForm from '../components/ReservaForm.astro';
import PosterLightbox from '../components/PosterLightbox.astro';

const menus = (await getCollection('menus', ({ data }) => data.active)).sort((a, b) => a.data.order - b.data.order);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: 'Menús de Navidad con zambomba',
  hasMenuSection: menus.map((m) => ({
    '@type': 'MenuSection',
    name: m.data.name,
    description: m.data.summary,
    offers: { '@type': 'Offer', price: m.data.price, priceCurrency: 'EUR' },
    hasMenuItem: m.data.courses.flatMap((c) => c.items.map((i) => ({ '@type': 'MenuItem', name: i }))),
  })),
};
---
<Base
  title="Menús de Navidad con zambomba en Jerez"
  description="Menús de Navidad en el centro de Jerez con zambomba en directo: Menú 1, Menú 2, sin gluten, vegano e infantil. Platos, precios por persona y reserva por WhatsApp."
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Temporada de Navidad"
    title="Nuestros menús"
    accent="de Navidad"
    lead="Entrantes para compartir, solomillo al oloroso, bodega incluida y zambomba en directo. Elige tu menú y resérvalo en un solo mensaje."
    image="/img/menus-hero.jpg"
    alt="Mesa de Navidad con platos típicos de Jerez"
  />

  <section class="section">
    <div class="container">
      <ul class="notes">
        <li><Icon name="music" />Actuación en directo de {site.band} todos los días</li>
        <li><Icon name="glass" />Bodega incluida en los menús de adulto</li>
        <li><Icon name="check" />Menús sin gluten, vegano e infantil</li>
      </ul>

      <div class="grid grid-3 list">
        {menus.map((m) => <MenuCard menu={m} />)}
      </div>

      <div class="extra">
        <div>
          <h2>¿Venís <em class="accent">en grupo</em>?</h2>
          <p class="muted">Para comidas de empresa y grupos grandes, cuéntanos cuántos sois y qué fecha buscáis, y te informamos de disponibilidad y promociones en copas.</p>
        </div>
        <a class="btn btn-wa" href={waLink('Hola, somos un grupo de ___ personas y queremos reservar para el día ___.')} target="_blank" rel="noopener"><Icon name="whatsapp" /> Consultar para grupos</a>
      </div>

      <p class="small muted">Precios por persona. Si tienes alguna alergia o intolerancia, avísanos al reservar.<br />Promoción: {site.drinkPromo}.</p>
    </div>
  </section>

  <section class="section tight bg-cream">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Carteles</span>
        <h2>Nuestros menús <em class="accent">en cartel</em></h2>
        <p class="lead">Pulsa para verlos en grande o compartirlos con tu grupo.</p>
      </div>
      <ul class="posters">
        {menus.filter((m) => m.data.poster).map((m) => (
          <li>
            <button type="button" data-poster={m.data.poster} data-title={`Cartel del ${m.data.name}`} aria-label={`Ver cartel del ${m.data.name}`}>
              <picture>
                <source srcset={m.data.poster!.replace(/\.jpe?g$/, '.webp')} type="image/webp" />
                <img src={m.data.poster} alt={`Cartel del ${m.data.name}, ${m.data.price} € por persona`} width="1024" height="1280" loading="lazy" decoding="async" />
              </picture>
              <span>{m.data.name} · {m.data.price} €</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="reservar">
    <div class="container narrow">
      <ReservaForm title="Reserva tu menú" />
    </div>
  </section>

  <PosterLightbox />
</Base>

<style>
  .notes { list-style: none; margin: 0 0 clamp(48px, 6vw, 72px); padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 28px; }
  .notes li { display: flex; align-items: center; gap: 10px; color: var(--ink-700); font-weight: 500; }
  .notes :global(svg) { width: 20px; height: 20px; color: var(--wine-700); }
  .list { align-items: start; }
  .extra {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px;
    margin-top: clamp(48px, 6vw, 72px); padding: clamp(28px, 4vw, 44px);
    background: var(--cream-100); border-radius: var(--radius); border: 1px solid var(--line);
  }
  .extra h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .extra p { margin: 0; max-width: 56ch; }
  .small { font-size: 0.88rem; text-align: center; margin-top: 28px; }
  .posters { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  .posters button { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; text-align: center; font: inherit; }
  .posters img { width: 100%; height: auto; border-radius: var(--radius-sm); box-shadow: var(--shadow); transition: transform 0.3s, box-shadow 0.3s; }
  .posters button:hover img { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(34, 21, 15, 0.2); }
  .posters span { display: block; margin-top: 10px; font-weight: 600; color: var(--wine-800); font-size: 0.95rem; }
  @media (max-width: 640px) { .notes { flex-direction: column; align-items: flex-start; max-width: 420px; margin-inline: auto; } }
  @media (max-width: 1000px) { .posters { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .posters { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }
</style>

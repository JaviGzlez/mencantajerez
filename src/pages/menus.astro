---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site, waLink } from '../data/site';
import PosterGrid from '../components/PosterGrid.astro';
import PosterLightbox from '../components/PosterLightbox.astro';

const menus = (await getCollection('menus', ({ data }) => data.active)).sort((a, b) => a.data.order - b.data.order);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: 'Menús de Navidad con zambomba',
  hasMenuSection: menus.map((m) => ({
    '@type': 'MenuSection',
    name: m.data.name,
    description: m.data.summary,
    offers: { '@type': 'Offer', price: m.data.price, priceCurrency: 'EUR' },
    hasMenuItem: m.data.courses.flatMap((c) => c.items.map((i) => ({ '@type': 'MenuItem', name: i }))),
  })),
};
---
<Base
  title="Menús de Navidad con zambomba en Jerez"
  description="Menús de Navidad en el centro de Jerez con zambomba en directo: Menú 1, Menú 2, sin gluten, vegano e infantil. Platos, precios por persona y reserva por WhatsApp."
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Temporada de Navidad"
    title="Nuestros menús"
    accent="de Navidad"
    lead="Almuerzos de Navidad en una de las bodegas más emblemáticas de Jerez, con bebida incluida y zambomba en directo."
    image="/img/fotos/14-brindis-mesa.jpg"
    alt="Comensales brindando en el almuerzo de Navidad de Mencanta Jerez"
    focus="center 40%"
  />

  <section class="section">
    <div class="container">
      <ul class="notes">
        <li><Icon name="music" />Actuación en directo de {site.band} todos los días</li>
        <li><Icon name="glass" />Bebida incluida en los menús de adulto</li>
        <li><Icon name="check" />Menús sin gluten, vegano e infantil</li>
      </ul>

      <PosterGrid />

      <p class="book"><a class="btn btn-lg" href="/contacto#reservar" data-reserva>Reservar mesa <Icon name="arrow" /></a></p>

      <p class="small muted">Pulsa en un cartel para verlo en grande. Solo almuerzos, los fines de semana de noviembre y diciembre.</p>

      <div class="extra">
        <div>
          <h2>¿Venís <em class="accent">en grupo</em>?</h2>
          <p class="muted">Para comidas de empresa y grupos grandes, cuéntanos cuántos sois y qué fecha buscáis, y te informamos de disponibilidad y promociones en copas.</p>
        </div>
        <a class="btn" href="/contacto#reservar" data-reserva>Reservar para grupo</a>
      </div>
    </div>
  </section>

  <PosterLightbox />
</Base>

<style>
  .notes { list-style: none; margin: 0 0 clamp(48px, 6vw, 72px); padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 28px; }
  .notes li { display: flex; align-items: center; gap: 10px; color: var(--ink-700); font-weight: 500; }
  .notes :global(svg) { width: 20px; height: 20px; color: var(--wine-700); }
  .extra {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px;
    margin-top: clamp(48px, 6vw, 72px); padding: clamp(28px, 4vw, 44px);
    background: var(--cream-100); border-radius: var(--radius); border: 1px solid var(--line);
  }
  .extra h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .extra p { margin: 0; max-width: 56ch; }
  .small { font-size: 0.88rem; text-align: center; margin-top: 18px; }
  .book { text-align: center; margin: clamp(32px, 4vw, 44px) 0 0; }
  .btn-lg { min-height: 56px; padding: 14px 36px; font-size: 1.05rem; }
  @media (max-width: 640px) { .notes { flex-direction: column; align-items: flex-start; max-width: 420px; margin-inline: auto; } }
</style>

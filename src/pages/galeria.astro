---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import { galeria, fotos } from '../data/fotos';

const photos = galeria;
---
<Base title="Galería de fotos" description="Fotos de nuestros almuerzos de Navidad con zambomba en Jerez: la zambomba en directo, el cante, la mesa y el mejor ambiente en el centro de Jerez.">
  <PageHero
    eyebrow="Galería"
    title="Momentos que quedan"
    accent="para siempre"
    image={fotos.escenario.src}
    alt="Ambiente de zambomba de noche"
  />

  <section class="section">
    <div class="container">
      <div class="masonry" data-gallery>
        {photos.map((p, i) => (
          <button class:list={['item', { wide: p.wide }]} data-index={i} aria-label={`Ampliar: ${p.alt}`}>
            <Photo src={p.src} alt={p.alt} />
          </button>
        ))}
      </div>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Foto ampliada">
    <button class="lb-close" data-close aria-label="Cerrar">×</button>
    <button class="lb-nav prev" data-prev aria-label="Anterior">‹</button>
    <img data-lb-img alt="" />
    <button class="lb-nav next" data-next aria-label="Siguiente">›</button>
  </dialog>

  <CtaBand />
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const items = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery] .item')];
  let idx = 0;
  const show = (i: number) => {
    idx = (i + items.length) % items.length;
    const src = items[idx].querySelector('img');
    if (!src) return false;
    img.src = src.currentSrc || src.src;
    img.alt = src.alt;
    return true;
  };
  items.forEach((b, i) => b.addEventListener('click', () => { if (show(i)) dlg.showModal(); }));
  dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('[data-prev]')!.addEventListener('click', () => show(idx - 1));
  dlg.querySelector('[data-next]')!.addEventListener('click', () => show(idx + 1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  document.addEventListener('keydown', (e) => {
    if (!dlg.open) return;
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
</script>

<style>
  .masonry { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 260px; gap: 12px; grid-auto-flow: dense; }
  .item { padding: 0; border: 0; border-radius: var(--radius-sm); overflow: hidden; cursor: zoom-in; background: var(--wine-900); }
  .item :global(.photo) { transition: transform 0.6s ease, opacity 0.3s; }
  .item:hover :global(.photo) { transform: scale(1.04); }
  .wide { grid-column: span 2; }
  .lightbox { padding: 0; border: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  .lightbox::backdrop { background: rgba(15, 2, 4, 0.94); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox img { max-width: min(92vw, 1400px); max-height: 86vh; object-fit: contain; border-radius: 6px; }
  .lb-close, .lb-nav { position: fixed; background: rgba(255, 255, 255, 0.08); color: #fff; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 50%; width: 50px; height: 50px; font-size: 1.8rem; line-height: 1; cursor: pointer; }
  .lb-close { top: 20px; right: 20px; }
  .lb-nav { top: 50%; transform: translateY(-50%); }
  .prev { left: 20px; } .next { right: 20px; }
  @media (max-width: 760px) {
    .masonry { grid-template-columns: 1fr 1fr; grid-auto-rows: 170px; }
  }
</style>
